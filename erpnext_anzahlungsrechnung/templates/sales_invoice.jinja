{% set company = frappe.get_doc("Company", doc.company) %}
{% set cmp_addr = frappe.get_doc("Address", doc.company_address) if doc.company_address else None %}
{% set pay_addr = frappe.get_doc("Address", doc.customer_address) if doc.customer_address else None %}

{% if doc.contact_person %}
{% set contact = frappe.get_doc("Contact", doc.contact_person) %}
{% endif %}

<!-- HEAD -->
<div id="header">
	<div class="letter-head">
		{{ letter_head }}
	</div>
</div>

<div class="contact-row">
	<div id="address">
		{% if cmp_addr %}
		<div id="sender">
			<p>{{ cmp_addr.address_title }} &#183; {{ cmp_addr.address_line1 }} &#183;
				{% if cmp_addr.address_line2 %}{{ cmp_addr.address_line2 }} <br>{% endif %}
				{{ cmp_addr.pincode }} {{ cmp_addr.city }}
				{% if pay_addr and (cmp_addr.country != pay_addr.country) -%}
				&#183; {{ cmp_addr.country | upper }}
				{%- endif %}
			</p>
		</div>
		{% endif %}
		{{ doc.address_display or "" }}
	</div>

	<div id="contact">
		<table class="w-100 text-small">
			{% if company.phone_no %}
				<tr>
					<td>{{ _("Phone") }}:</td>
					<td class="text-right">{{ company.phone_no }}</td>
				</tr>
			{% endif %}
			{% if company.email %}
				<tr>
					<td>{{ _("Email") }}:</td>
					<td class="text-right">{{ company.email }}</td>
				</tr>
			{% endif %}
				<tr>
					<td>{{ _("Date") }}:</td>
					<td class="text-right">{{ frappe.utils.formatdate(doc.posting_date, "dd.mm.yyyy") }}</td>
				</tr>
			{% if doc.po_no %}
				<tr>
					<td>{{ _("Your PO No.") }}:</td>
					<td class="text-right">{{ doc.po_no }}</td>
				</tr>
			{% endif %}

			{% if doc.tax_id %}
				<tr>
					<td>{{ _("Your Tax ID") }}:</td>
					<td class="text-right">{{ doc.tax_id }}</td>
				</tr>
			{% endif %}

			{% set performance_from = doc.custom_service_period_from or doc.from_date %}
			{% set performance_to = doc.custom_service_period_to or doc.to_date %}
			{% if performance_from and performance_to %}
				<tr>
					<td>{{ _("Performance Period") }}:</td>
					{# If the year matches (first 4 chars in ISO-string), omit it for from_date #}
					{% if performance_from.year is defined %}
					{% set date_format = "dd.mm." if performance_from.year == performance_to.year else "dd.mm.yy" %}
					{% else %}
					{% set date_format = "dd.mm." if performance_from[:4] == performance_to[:4] else "dd.mm.yy" %}
					{% endif %}
					<td class="text-right">{{ frappe.utils.formatdate(performance_from, date_format) }} - {{
						frappe.utils.formatdate(performance_to, "dd.mm.yyyy") }}</td>
				</tr>
			{% elif performance_from %}
				<tr>
					<td>{{ _("Performance Period") }}:</td>
					<td class="text-right">{{ frappe.utils.formatdate(performance_from, "MMMM yyyy") }}</td>
				</tr>
			{% endif %}
		</table>
	</div>
</div>

<div id="faltmarke-1" class="din-mark"></div>
<div id="lochmarke" class="din-mark"></div>
<div id="faltmarke-2" class="din-mark"></div>

<!-- CONTENT -->
{% set show_tax_rate_col = not (doc.get("custom_invoice_type") == "Down Payment Invoice" and doc.get("custom_summarize_positions")) %}
<div id="text">
	<div id="subject">
		{% if doc.is_return %}
			<p><strong>{{ _("Correction Invoice") }} {{ doc.name }}</strong></p>
			<p class="text-small">{{ _("Rectifies invoice {0}").format(doc.return_against) }}</p>
		{% elif doc.amended_from %}
			<p><strong>{{ _("Cancellation Invoice") }} {{ doc.name }}</strong></p>
			<p class="text-small">{{ _("Fully cancels and replaces invoice {0}").format(doc.amended_from) }}</p>
		{% else %}
			{% if doc.get("custom_invoice_type") == "Down Payment Invoice" %}
				<p><strong>{{ _("Down Payment Invoice") }} {{ doc.name }}</strong></p>
			{% elif doc.get("custom_invoice_type") == "Final Invoice" %}
				<p><strong>{{ _("Final Invoice") }} {{ doc.name }}</strong></p>
			{% else %}
				<p><strong>{{ _("Invoice") }} {{ doc.name }}</strong></p>
			{% endif %}
		{% endif %}
	</div>

	<table class="w-100 text-small">
		<thead class="black-border">
			<tr>
				<th style="width: 5%">{{ _("Sr") }}</th>
				<th style="width: {{ '38%' if show_tax_rate_col else '45%' }}">
					{{ _("Description") }}</th>
				<th style="width: 10%">{{ _("Unit") if not print_settings.print_uom_after_quantity else '&nbsp;'}}</th>
				<th style="width: {{ '9%' if show_tax_rate_col else '10%' }}">{{ _("Qty") }}</th>
				<th style="width: {{ '11%' if show_tax_rate_col else '12%' }}">{{ _("Price") }}</th>
				{% if show_tax_rate_col %}
				<th style="width: 8%">{{ _("Tax Rate") }}</th>
				{% endif %}
				<!-- <th style="width: 15%">{{ _("Discount") }}</th> -->
				<th style="width: {{ '19%' if show_tax_rate_col else '18%' }}" class="text-right">{{ _("Amount") }}</th>
			</tr>
		</thead>
		<tbody>
			{% for n in doc.items %}
				<tr>
					<td>{{ loop.index }}</td>
					<td><b>{{ _(n.item_name) }}</b></td>
					<td>{{ _(n.uom) if not print_settings.print_uom_after_quantity else '&nbsp;'}}</td>
					<td>
						{{ n.get_formatted("qty") }}
						{% if print_settings.print_uom_after_quantity %}
						{{ _(n.uom) }}
						{% endif %}
					</td>
					<td>{{ n.get_formatted("rate") }}</td>
					{% if show_tax_rate_col %}
					<td class="text-right">
						{% if n.tax_rate %}
							{% for r in n.tax_rate %}
								{%- if not loop.first %} + {% endif -%}
								{{ frappe.format(r, {"fieldtype": "Float", "precision": 2}) }}&nbsp;&percnt;
							{% endfor %}
						{% endif %}
					</td>
					{% endif %}
					<!-- <td>{{ n.get_formatted("discount_amount") }}</td> -->
					<td class="text-right">{{ n.get_formatted("amount") }}</td>
				</tr>
				<tr>
					<td></td>
					<td colspan="{{ 5 if show_tax_rate_col else 4 }}">
						{{ n.description }}
						{% if n.custom_service_period_from and n.custom_service_period_to %}
							<br>
							<span class="text-small">
								{{ _("Performance Period") }}:
								{% if n.custom_service_period_from.year is defined %}
									{% set item_date_format = "dd.mm." if n.custom_service_period_from.year == n.custom_service_period_to.year else "dd.mm.yy" %}
								{% else %}
									{% set item_date_format = "dd.mm." if n.custom_service_period_from[:4] == n.custom_service_period_to[:4] else "dd.mm.yy" %}
								{% endif %}
								{{ frappe.utils.formatdate(n.custom_service_period_from, item_date_format) }} - {{
									frappe.utils.formatdate(n.custom_service_period_to, "dd.mm.yyyy") }}
							</span>
						{% elif n.custom_service_period_from %}
							<br>
							<span class="text-small">
								{{ _("Performance Period") }}: {{ frappe.utils.formatdate(n.custom_service_period_from, "MMMM yyyy") }}
							</span>
						{% endif %}
					</td>
					<td></td>
				</tr>
			{% endfor %}
		</tbody>

		<tfoot class="black-border">
			{% if doc.additional_discount_percentage or doc.discount_amount %}
				<tr>
					<td></td>
					<td>{{ _("Total") }}</td>
					<td></td>
					<td></td>
					<td></td>
					{% if show_tax_rate_col %}<td></td>{% endif %}
					<td class="text-right">{{ doc.get_formatted("total") }}</td>
				</tr>
				<tr>
					<td></td>
					<td>{{ _("Discount") }}</td>
					<td></td>
					<td></td>
					<td>
						{% if doc.additional_discount_percentage %}
							{{ doc.get_formatted("additional_discount_percentage") }} &percnt;
						{% endif %}
					</td>
					{% if show_tax_rate_col %}<td></td>{% endif %}
					<td class="text-right">
						{{ doc.get_formatted("discount_amount") }}
					</td>
				</tr>
			{% endif %}
			<tr>
				<td></td>
				<td>{{ _("Net Total") }}</td>
				<td></td>
				<td></td>
				<td></td>
				{% if show_tax_rate_col %}<td></td>{% endif %}
				<td class="text-right">{{ doc.get_formatted("net_total") }}</td>
			</tr>
			{% for tax_row in doc.taxes -%}
				{% if tax_row.tax_amount or print_settings.print_taxes_with_zero_amount %}
					<tr>
						<td></td>
						<td>
							{{ tax_row.description }}
						</td>
						<td></td>
						<td></td>
						<td></td>
						{% if show_tax_rate_col %}<td></td>{% endif %}
						<td class="text-right">
							{{ tax_row.get_formatted("tax_amount") }}
						</td>
					</tr>
				{% endif %}
			{%- endfor %}

			{% if doc.tax_exemption_reason %}
				<tr>
					<td></td>
					<td colspan="{{ 5 if show_tax_rate_col else 4 }}">{{ _(doc.tax_exemption_reason) }}</td>
					<td></td>
				</tr>
			{% endif %}
			<tr>
				<td></td>
				<td>
					<strong>{{ _("Grand Total") }}</strong>
				</td>
				<td></td>
				<td></td>
				<td></td>
				{% if show_tax_rate_col %}<td></td>{% endif %}
				<td class="text-right"><strong>{{ doc.get_formatted("grand_total") }}</strong>
				</td>
			</tr>
			{% if doc.total_advance %}
				<tr>
					<td></td>
					<td>{{ _("Total Advance") }}</td>
					<td></td>
					<td></td>
					<td></td>
					{% if show_tax_rate_col %}<td></td>{% endif %}
					<td class="text-right">
						{{ doc.get_formatted("total_advance") }}
					</td>
				</tr>
				<tr>
					<td></td>
					<td>{{ _("Outstanding Amount") }}</td>
					<td></td>
					<td></td>
					<td></td>
					{% if show_tax_rate_col %}<td></td>{% endif %}
					<td class="text-right">
						{{ doc.get_formatted("outstanding_amount") }}
					</td>
				</tr>
			{% endif %}
			{% if doc.get("custom_invoice_type") == "Final Invoice" and doc.get("custom_down_payments") %}
				{# Nested table: main grid maps Description/Qty/… to different semantics; own colgroup fixes widths. #}
				<tr class="prior-down-payments-wrap">
					<td colspan="{{ 7 if show_tax_rate_col else 6 }}" class="prior-down-payments-cell" style="padding-top: 0.35rem;">
						<table class="w-100 text-small prior-down-payments-subtable" style="table-layout: fixed; width: 100%;">
							<colgroup>
								<col style="width: 24%" />
								<col style="width: 14%" />
								<col style="width: 20%" />
								<col style="width: 20%" />
								<col style="width: 22%" />
							</colgroup>
							<tbody>
								<tr class="prior-down-payments-header">
									<td colspan="5"><strong>{{ _("Prior Down Payment Invoices") }}</strong></td>
								</tr>
								<tr>
									<td>{{ _("Invoice No.") }}</td>
									<td>{{ _("Paid On") }}</td>
									<td class="text-right">{{ _("Net Amount") }}</td>
									<td class="text-right">{{ _("Tax Amount") }}</td>
									<td class="text-right">{{ _("Grand Total") }}</td>
								</tr>
								{% for dp in doc.custom_down_payments %}
									<tr class="prior-down-payment-row">
										<td>{{ dp.invoice_no }}</td>
										<td>{% if dp.payment_date %}{{ frappe.utils.formatdate(dp.payment_date, "dd.mm.yyyy") }}{% endif %}</td>
										<td class="text-right">{{ frappe.utils.fmt_money(dp.net_total, currency=doc.currency) }}</td>
										<td class="text-right">{{ frappe.utils.fmt_money(dp.tax_amount, currency=doc.currency) }}</td>
										<td class="text-right">{{ frappe.utils.fmt_money(dp.grand_total, currency=doc.currency) }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</td>
				</tr>
				<tr class="prior-down-payments-outstanding">
					<td colspan="2"><strong>{{ _("Outstanding After Down Payments") }}</strong></td>
					<td></td>
					<td></td>
					<td></td>
					{% if show_tax_rate_col %}<td></td>{% endif %}
					<td class="text-right"><strong>{{ frappe.utils.fmt_money(doc.outstanding_amount, currency=doc.currency) }}</strong></td>
				</tr>
			{% endif %}
		</tfoot>
	</table>

	{% if doc.incoterm %}
		<p>{{ _("Terms of delivery") }}: Incoterms® 2020 {{ doc.incoterm }}{% if doc.named_place %} {{ doc.named_place }}{%
			endif %}</p><br>
	{% endif %}

	{% if doc.terms and (doc.terms | striptags) %}
		<br>
		{{ doc.terms }}
	{% endif %}

	{% if doc.timesheets -%}
		<div style="page-break-after: always"></div>
		<div class="timesheets">
			<p style="padding-top: 1em; padding-bottom: 0.33em">
				<strong>{{ _("Time Logs") }}</strong>
			</p>
			<div data-fieldname="timesheets" data-fieldtype="Table">
				<table class="w-100 text-small">
					<thead class="black-border">
						<tr>
							<th style="width: 40px" class="table-sr">{{ _("Sr") }}</th>
							<th style="width: 80px;" class="" data-fieldname="timesheets" data-fieldtype="Table">
								{{_("Date")}}</th>
							<th style="width: 370px;" class="" data-fieldname="timesheets" data-fieldtype="Table">
								{{_("Note")}}</th>
							<th style="width: 80px;" class="text-right" data-fieldname="timesheets" data-fieldtype="Table">
								{{_("Duration")}}</th>
						</tr>
					</thead>
					<tbody>
						{% for time_log in doc.timesheets | sort(attribute="start_date") %}
							{% set timesheet = frappe.get_doc("Timesheet", time_log.time_sheet)%}
							{% if timesheet.total_billable_amount > 0 %}
							<tr style="page-break-inside: avoid;">
								<td class="table-sr">{{ loop.index }}</td>
								<td class="" data-fieldname="timesheets" data-fieldtype="Table">
									<div class="value">
										{{ frappe.utils.formatdate(timesheet.start_date, "dd.mm.yy") }}
									</div>
								</td>
								<td class="" data-fieldname="timesheets" data-fieldtype="Table">
									<div class="value">
										{{ time_log.description }}
									</div>
								</td>
								<td class="text-right" data-fieldname="timesheets" data-fieldtype="Table">
									<div class="value">
										{{
										frappe.format(
										frappe.utils.rounded(time_log.billing_hours * 60) * 60,
										{"fieldtype": "Duration"}
										)
										}}
									</div>
								</td>
							</tr>
							{% endif %}
						{% endfor %}
					</tbody>
					<tfoot class="black-border">
						<tr>
							<td></td>
							<td></td>
							<td>
								<strong>
									{{ _("Total Duration") }}
								</strong>
							</td>
							<td class="text-right">
								<strong>
									{{
									frappe.format(
									frappe.utils.rounded(doc.total_billing_hours * 60) * 60,
									{"fieldtype": "Duration", "hide_days": 1}
									)
									}}
								</strong>
							</td>
						</tr>
					</tfoot>
				</table>
			</div>
		</div>
	{%- endif %}
</div>

<!-- FOOTER -->
<div id="footer-html" class="visible-pdf">
	<div class="letter-head-footer">
		<p id="pagenum">
			{{ _("Page {0} of {1}").format('<span class="page"></span>', '<span class="topage"></span>') }}
		</p>
		<div class="print-format-footer">
			{{ footer }}
		</div>
	</div>
</div>
